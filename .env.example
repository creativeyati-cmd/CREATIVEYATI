# Public Supabase values: Project Settings → API → Project URL and Publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Project Settings → API → service_role key. Never expose this value.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admins sign in through Supabase Auth and must be listed in public.admin_users.
# Authenticator MFA is required. Legacy ADMIN_EMAIL/ADMIN_PASSWORD login is retired.
# Server-only secret for short-lived password recovery grants.
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Encrypts dashboard-managed secrets (Bachs credentials) before storage.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SMTP_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Sendhiiv server-only API key, used for every outgoing message
# (Sendhiiv Dashboard → API keys). Supabase Auth OTP mail uses the Sendhiiv
# SMTP relay instead — set that under Supabase → Authentication → SMTP.
SENDHIIV_API_KEY=replace_with_sendhiiv_api_key

# Server-only Bachs credentials. Start with a sandbox key, then swap to a live
# key after approval. Configure https://aivideocreator.cv/api/payments/webhook
# in the Bachs Developer Portal and copy that endpoint's signing secret.
BACHS_API_KEY=sk_sandbox_replace_me
BACHS_WEBHOOK_SECRET=replace_with_bachs_endpoint_signing_secret

# Shared secret for POST /api/payments/reconcile, the scheduled sweep that
# re-checks orders still pending after a missed webhook. Leave unset to disable.
PAYMENT_RECONCILE_SECRET=

# Optional protected course-video provider settings. Vimeo domain privacy can
# be configured in Vimeo itself; never expose provider API secrets publicly.
COURSE_VIDEO_PROVIDER=vimeo

# Cloudflare Stream direct uploads. Keep supabase until Stream authorization and
# a test upload succeed. Server-only values; never prefix these with NEXT_PUBLIC_.

# Private R2 videos (server only)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Existing scheduler sends Authorization: Bearer <this secret> to /api/jobs/communications.
# Generate a random secret of at least 32 characters. Never prefix with NEXT_PUBLIC_.
COMMUNICATIONS_JOB_SECRET=
